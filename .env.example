TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather

# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow everyone. Recommended on a public server.
# ALLOWED_USER_IDS=123456789

# Max parallel downloads across all users (default: 3)
MAX_CONCURRENT_DOWNLOADS=3

# Donate button amount in Telegram Stars (default: 50)
DONATE_STARS=50

# Path to Netscape cookies.txt for YouTube (inside container: /app/cookies.txt)
# Export via browser extension, see README.
# YTDLP_COOKIES_FILE=/app/cookies.txt

# HTTP(S) proxy for YouTube only (recommended on datacenter VPS)
# YTDLP_PROXY=http://user:pass@host:port

